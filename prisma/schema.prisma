generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas   = ["identity"]
}

enum AccountType {
  CUSTOMER
  STAFF

  @@schema("identity")
}

enum StaffMfaStatus {
  NOT_ENROLLED
  ENROLLMENT_PENDING
  ACTIVE

  @@schema("identity")
}

enum AuthenticationMethod {
  PASSWORD
  SMS_OTP
  PASSWORD_TOTP
  PASSWORD_RECOVERY_CODE

  @@schema("identity")
}

enum SessionRevocationReason {
  LOGOUT
  SIGN_OUT_ALL
  PASSWORD_CHANGED
  PASSWORD_RESET
  ACCOUNT_DISABLED
  MFA_RESET
  REFRESH_REPLAY
  ADMINISTRATIVE
  SECURITY_EVENT
  EXPIRED

  @@schema("identity")
}

enum StaffMfaTransactionPurpose {
  STAFF_SIGN_IN_MFA

  @@schema("identity")
}

enum StaffMfaEnrollmentPurpose {
  STAFF_MFA_ENROLLMENT

  @@schema("identity")
}

enum OtpPurpose {
  CUSTOMER_LOGIN

  @@schema("identity")
}

enum SmsOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  EXPIRED
  CANCELLED

  @@schema("identity")
}

enum OtpQuotaWindow {
  HOUR
  DAY

  @@schema("identity")
}

enum AuditActorType {
  CUSTOMER
  STAFF
  SYSTEM

  @@schema("identity")
}

model IdentityUser {
  id                       String      @id @db.Uuid
  accountType              AccountType @map("account_type")
  userName                 String      @map("user_name") @db.VarChar(256)
  normalizedUserName       String      @unique(map: "ux_identity_users_normalized_user_name") @map("normalized_user_name") @db.VarChar(256)
  email                    String?     @map("email") @db.VarChar(320)
  normalizedEmail          String?     @map("normalized_email") @db.VarChar(320)
  emailConfirmed           Boolean     @default(false) @map("email_confirmed")
  phoneNumber              String?     @map("phone_number") @db.VarChar(16)
  phoneNumberConfirmed     Boolean     @default(false) @map("phone_number_confirmed")
  passwordHash             String?     @map("password_hash") @db.VarChar(512)
  securityStamp            String      @map("security_stamp") @db.VarChar(128)
  concurrencyStamp         String      @map("concurrency_stamp") @db.VarChar(128)
  isActive                 Boolean     @map("is_active")
  mustChangePassword       Boolean     @map("must_change_password")
  accessFailedCount        Int         @default(0) @map("access_failed_count")
  lockoutEnd               DateTime?   @map("lockout_end") @db.Timestamptz(6)
  mfaLockoutEnd            DateTime?   @map("mfa_lockout_end") @db.Timestamptz(6)
  staffMfaStatus            StaffMfaStatus? @map("staff_mfa_status")
  createdAt                DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles                IdentityUserRole[]
  sessions                 AuthSession[]
  staffMfaTransactions     StaffMfaTransaction[]
  staffAuthenticator       StaffAuthenticator?
  staffRecoveryCodes       StaffRecoveryCode[]
  staffMfaInvitations      StaffMfaEnrollmentInvitation[]
  staffEnrollmentTx        StaffMfaEnrollmentTransaction[]
  staffPasswordChanges     StaffPasswordChangeTransaction[]
  customerOtpChallenges    CustomerOtpChallenge[]
  assignedUserRoles        IdentityUserRole[] @relation("UserRoleAssigner")
  createdMfaInvitations    StaffMfaEnrollmentInvitation[] @relation("MfaInvitationCreator")
  auditEvents              IdentityAuditEvent[] @relation("AuditActor")

  @@unique([id, accountType], map: "ux_identity_users_id_account_type")
  @@index([normalizedEmail], map: "ix_identity_users_normalized_email")
  @@index([phoneNumber], map: "ix_identity_users_phone_number")
  @@map("users")
  @@schema("identity")
}

model IdentityRole {
  id          String   @id @db.Uuid
  name        String   @unique(map: "ux_identity_roles_name") @db.VarChar(128)
  normalizedName String @unique(map: "ux_identity_roles_normalized_name") @map("normalized_name") @db.VarChar(128)
  description String?  @db.VarChar(512)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users       IdentityUserRole[]
  permissions IdentityRolePermission[]

  @@map("roles")
  @@schema("identity")
}

model IdentityPermission {
  id          String   @id @db.Uuid
  key         String   @unique(map: "ux_identity_permissions_key") @db.VarChar(160)
  description String?  @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles       IdentityRolePermission[]

  @@map("permissions")
  @@schema("identity")
}

model IdentityUserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy String?  @map("assigned_by") @db.Uuid

  user IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_identity_user_roles_user")
  assignedByUser IdentityUser? @relation("UserRoleAssigner", fields: [assignedBy], references: [id], onDelete: SetNull, map: "fk_identity_user_roles_assigned_by")
  role IdentityRole @relation(fields: [roleId], references: [id], onDelete: Restrict, map: "fk_identity_user_roles_role")

  @@id([userId, roleId])
  @@index([roleId], map: "ix_identity_user_roles_role_id")
  @@map("user_roles")
  @@schema("identity")
}

model IdentityRolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  role       IdentityRole       @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "fk_identity_role_permissions_role")
  permission IdentityPermission @relation(fields: [permissionId], references: [id], onDelete: Restrict, map: "fk_identity_role_permissions_permission")

  @@id([roleId, permissionId])
  @@index([permissionId], map: "ix_identity_role_permissions_permission_id")
  @@map("role_permissions")
  @@schema("identity")
}

model AuthSession {
  id                String                  @id @db.Uuid
  userId            String                  @map("user_id") @db.Uuid
  actorKind         AccountType              @map("actor_kind")
  authenticationMethod AuthenticationMethod @map("authentication_method")
  authenticatedAt   DateTime                @map("authenticated_at") @db.Timestamptz(6)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt        DateTime                @map("last_seen_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime                @map("absolute_expires_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime                @map("idle_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?               @map("revoked_at") @db.Timestamptz(6)
  revocationReason  SessionRevocationReason? @map("revocation_reason")
  userAgentHash     String?                 @map("user_agent_hash") @db.Char(64)
  deviceLabel       String?                 @map("device_label") @db.VarChar(160)

  user          IdentityUser  @relation(fields: [userId, actorKind], references: [id, accountType], onDelete: Restrict, map: "fk_identity_auth_sessions_user_actor")
  refreshTokens RefreshToken[]

  @@unique([id, userId], map: "ux_identity_sessions_id_user")
  @@index([userId, createdAt], map: "ix_identity_sessions_user_created")
  @@index([userId, revokedAt, absoluteExpiresAt, idleExpiresAt], map: "ix_identity_sessions_active_lookup")
  @@map("auth_sessions")
  @@schema("identity")
}

model RefreshToken {
  id                String    @id @db.Uuid
  sessionId         String    @map("session_id") @db.Uuid
  secretHash        String    @unique(map: "ux_identity_refresh_tokens_secret_hash") @map("secret_hash") @db.Char(64)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt        DateTime? @map("consumed_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenId String?   @unique(map: "ux_identity_refresh_tokens_replaced_by") @map("replaced_by_token_id") @db.Uuid

  session       AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "fk_identity_refresh_tokens_session")
  replacedBy    RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: Restrict, map: "fk_identity_refresh_tokens_replaced_by")
  replaces      RefreshToken? @relation("RefreshTokenRotation")

  @@unique([sessionId, id], map: "ux_identity_refresh_tokens_session_id")
  @@index([sessionId, createdAt], map: "ix_identity_refresh_tokens_session_created")
  @@map("refresh_tokens")
  @@schema("identity")
}

model StaffMfaTransaction {
  id             String                      @id @db.Uuid
  userId         String                      @map("user_id") @db.Uuid
  secretHash     String                      @unique(map: "ux_identity_staff_mfa_transactions_secret_hash") @map("secret_hash") @db.Char(64)
  purpose        StaffMfaTransactionPurpose
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime                    @map("expires_at") @db.Timestamptz(6)
  failedAttempts Int                         @default(0) @map("failed_attempts")
  consumedAt     DateTime?                   @map("consumed_at") @db.Timestamptz(6)
  cancelledAt    DateTime?                   @map("cancelled_at") @db.Timestamptz(6)

  user IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "ix_identity_staff_mfa_transactions_user_created")
  @@index([expiresAt], map: "ix_identity_staff_mfa_transactions_expiry")
  @@map("staff_mfa_transactions")
  @@schema("identity")
}

model StaffAuthenticator {
  id                    String    @id @db.Uuid
  userId                String    @unique(map: "ux_identity_staff_authenticators_user") @map("user_id") @db.Uuid
  encryptedSecret       Bytes     @map("encrypted_secret")
  encryptionKeyVersion  String    @map("encryption_key_version") @db.VarChar(64)
  lastAcceptedTimeStep  BigInt?   @map("last_accepted_time_step")
  confirmedAt           DateTime? @map("confirmed_at") @db.Timestamptz(6)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_authenticators")
  @@schema("identity")
}

model StaffRecoveryCode {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  user IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash], map: "ux_identity_staff_recovery_codes_user_hash")
  @@index([userId, consumedAt, revokedAt], map: "ix_identity_staff_recovery_codes_available")
  @@map("staff_recovery_codes")
  @@schema("identity")
}

model StaffMfaEnrollmentInvitation {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique(map: "ux_identity_staff_mfa_invitations_token_hash") @map("token_hash") @db.Char(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(6)
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdByUserId String  @map("created_by_user_id") @db.Uuid

  user IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByUser IdentityUser @relation("MfaInvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, map: "fk_identity_staff_mfa_enrollment_invitations_created_by")

  @@index([userId, createdAt], map: "ix_identity_staff_mfa_invitations_user_created")
  @@index([expiresAt], map: "ix_identity_staff_mfa_invitations_expiry")
  @@map("staff_mfa_enrollment_invitations")
  @@schema("identity")
}

model StaffMfaEnrollmentTransaction {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  secretHash    String    @unique(map: "ux_identity_staff_enrollment_transactions_secret_hash") @map("secret_hash") @db.Char(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(6)
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(6)

  user IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "ix_identity_staff_enrollment_transactions_user_created")
  @@index([expiresAt], map: "ix_identity_staff_enrollment_transactions_expiry")
  @@map("staff_mfa_enrollment_transactions")
  @@schema("identity")
}

model StaffPasswordChangeTransaction {
  id          String    @id @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  secretHash  String    @unique(map: "ux_identity_staff_password_change_transactions_secret_hash") @map("secret_hash") @db.Char(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  user IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "ix_identity_staff_password_change_transactions_user_created")
  @@index([expiresAt], map: "ix_identity_staff_password_change_transactions_expiry")
  @@map("staff_password_change_transactions")
  @@schema("identity")
}

model CustomerOtpChallenge {
  id             String    @id @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  phoneNumber    String    @map("phone_number") @db.VarChar(16)
  purpose        OtpPurpose
  codeMac        String    @map("code_mac") @db.Char(64)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  failedAttempts Int       @default(0) @map("failed_attempts")
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(6)
  invalidatedAt  DateTime? @map("invalidated_at") @db.Timestamptz(6)

  user IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  outbox SmsOutboxMessage?

  @@index([userId, purpose, createdAt], map: "ix_identity_otp_challenges_user_purpose_created")
  @@index([phoneNumber, purpose, createdAt], map: "ix_identity_otp_challenges_phone_purpose_created")
  @@index([expiresAt], map: "ix_identity_otp_challenges_expiry")
  @@map("customer_otp_challenges")
  @@schema("identity")
}

model SmsOutboxMessage {
  id                String          @id @db.Uuid
  challengeId       String          @unique(map: "ux_identity_sms_outbox_challenge") @map("challenge_id") @db.Uuid
  protectedPayload  Bytes           @map("protected_payload")
  encryptionKeyVersion String       @map("encryption_key_version") @db.VarChar(64)
  status            SmsOutboxStatus @default(PENDING)
  attemptCount      Int             @default(0) @map("attempt_count")
  nextAttemptAt     DateTime        @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  leaseOwner        String?         @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt    DateTime?       @map("lease_expires_at") @db.Timestamptz(6)
  expiresAt         DateTime        @map("expires_at") @db.Timestamptz(6)
  terminalAt        DateTime?       @map("terminal_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  challenge CustomerOtpChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade, map: "fk_identity_sms_outbox_challenge")

  @@index([status, nextAttemptAt, createdAt], map: "ix_identity_sms_outbox_claim")
  @@index([expiresAt], map: "ix_identity_sms_outbox_expiry")
  @@map("sms_outbox")
  @@schema("identity")
}

model OtpSendQuota {
  id          String          @id @db.Uuid
  scopeKey    String          @map("scope_key") @db.VarChar(128)
  window      OtpQuotaWindow
  windowStart DateTime        @map("window_start") @db.Timestamptz(6)
  sendCount   Int             @map("send_count")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([scopeKey, window, windowStart], map: "ux_identity_otp_send_quotas_scope_window")
  @@index([windowStart], map: "ix_identity_otp_send_quotas_window_start")
  @@map("otp_send_quotas")
  @@schema("identity")
}

model IdentityAuditEvent {
  id             String        @id @db.Uuid
  actorType      AuditActorType @map("actor_type")
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  action         String        @db.VarChar(160)
  targetType     String        @map("target_type") @db.VarChar(128)
  targetId       String?       @map("target_id") @db.VarChar(128)
  reason         String?       @db.VarChar(512)
  correlationId  String?       @map("correlation_id") @db.VarChar(128)
  metadata       Json?
  occurredAt     DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([actorUserId, occurredAt], map: "ix_identity_audit_actor_occurred")
  actorUser IdentityUser? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull, map: "fk_identity_audit_events_actor")

  @@index([targetType, targetId, occurredAt], map: "ix_identity_audit_target_occurred")
  @@map("audit_events")
  @@schema("identity")
}
